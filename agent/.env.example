# Copy to .env.local (backend: agent/.env.local; frontend: console/.env.local)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=
# --------------------------------------------------------------------
# VISION behaviour (all optional)
# --------------------------------------------------------------------
# Gemini Live voice. One of: Aoede (default, calm), Puck, Charon, Kore,
# Fenrir, Leda, Orus, Zephyr. Unset or blank falls back to Aoede.
VISION_VOICE=Aoede
# BCP-47 language the voice speaks and listens in. Default: en-US.
VISION_LANGUAGE=en-US
# Search engine used by search_the_web: bing (default), google, duckduckgo.
VISION_SEARCH_PROVIDER=bing
